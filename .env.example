# Copy to .env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/insurance_navigator
SECRET_KEY=replace-with-a-long-random-string

# Optional. Set to 1 when serving over HTTPS.
# SESSION_COOKIE_SECURE=1

# AI explanation for the simulator ("Explain this change"). Server side only.
# Optional: without these the simulator shows a standard (non-AI) explanation.
# Choose a model ID from https://console.groq.com/docs/models (there is no default).
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-a-groq-model-id

# LOCAL DEBUGGING ONLY. 1 logs which tokens in a rejected AI reply failed validation
# (figures and labels only; never the key, prompt or user details). Never enable in production.
# AI_DEBUG=1
